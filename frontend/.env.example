# Vite public env only — never put secrets, refresh tokens, API signing keys, or private PEMs here.
# Local API calls use relative `/api/v1/...` via the Vite proxy (see vite.config.ts).
# Proxy matches `/api/v1` only so SPA routes like `/api-keys` are not forwarded to the backend.

# Optional override for non-proxied / production-style builds (absolute origin). Leave empty for local proxy.
VITE_API_BASE_URL=
