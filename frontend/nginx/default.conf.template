# PayFlow frontend — processed by nginx image envsubst (PAYFLOW_* only).
# Backend upstream defaults: payflow-backend:8080 (override via env).
# TLS is expected to terminate at an outer reverse proxy / load balancer.

upstream payflow_backend {
	server ${PAYFLOW_BACKEND_HOST}:${PAYFLOW_BACKEND_PORT};
}

server {
	listen 8080;
	server_name _;
	server_tokens off;
	autoindex off;

	root /usr/share/nginx/html;
	index index.html;

	# CSP: script-src 'self' only (no unsafe-eval). style-src allows 'unsafe-inline' for
	# React/Recharts inline style attributes; tighten further when the UI stops needing them.
	add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header X-Frame-Options "DENY" always;

	# --- API proxy (same-origin): preserves paths, cookies, CSRF ---
	location /api/v1/ {
		proxy_http_version 1.1;
		proxy_pass http://payflow_backend;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header Connection "";

		# Browser session: HttpOnly refresh + non-HttpOnly XSRF-TOKEN pass through unchanged
		proxy_pass_header Set-Cookie;
		proxy_hide_header X-Powered-By;

		add_header Cache-Control "no-store" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header X-Frame-Options "DENY" always;

		proxy_connect_timeout 5s;
		proxy_send_timeout 60s;
		proxy_read_timeout 60s;
	}

	# Public health probes only (status UP/DOWN; show-details never on backend).
	# Do not proxy /actuator/metrics or other Actuator paths.
	location = /actuator/health {
		proxy_http_version 1.1;
		proxy_pass http://payflow_backend/actuator/health;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		add_header Cache-Control "no-store" always;
		proxy_connect_timeout 3s;
		proxy_read_timeout 5s;
	}

	location = /actuator/health/liveness {
		proxy_http_version 1.1;
		proxy_pass http://payflow_backend/actuator/health/liveness;
		proxy_set_header Host $host;
		add_header Cache-Control "no-store" always;
		proxy_connect_timeout 3s;
		proxy_read_timeout 5s;
	}

	location = /actuator/health/readiness {
		proxy_http_version 1.1;
		proxy_pass http://payflow_backend/actuator/health/readiness;
		proxy_set_header Host $host;
		add_header Cache-Control "no-store" always;
		proxy_connect_timeout 3s;
		proxy_read_timeout 5s;
	}

	location /actuator/ {
		return 404;
	}

	# Fingerprinted Vite assets
	location /assets/ {
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'" always;
		try_files $uri =404;
	}

	location = /index.html {
		add_header Cache-Control "no-store" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header X-Frame-Options "DENY" always;
		add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'" always;
	}

	# SPA fallback — never catch /api/v1/ (handled above)
	location / {
		try_files $uri $uri/ /index.html;
	}
}
