# PayFlow local environment — placeholders only.
# Copy to .env and fill in values. Never commit .env.

# --- Application ---
APP_ENV=local
APP_PORT=8080
FRONTEND_PORT=5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change_me_local_only

# JDBC URL used by Spring Boot (Compose maps container 5432 -> host 5433)
DATABASE_URL=jdbc:postgresql://localhost:5433/payflow
DATABASE_USERNAME=payflow
DATABASE_PASSWORD=change_me_local_only

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka (optional Compose profile: kafka; host listener on 9094) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
PAYFLOW_KAFKA_ENABLED=false

# --- Spring ---
SPRING_PROFILES_ACTIVE=local

# --- Security (generate local values; never use these in production) ---
API_KEY_HASH_PEPPER=replace_with_long_random_local_pepper
JWT_ISSUER=payflow
JWT_AUDIENCE=payflow-api
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_PRIVATE_KEY_PATH=local-secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=local-secrets/jwt-public.pem
JWT_AUTO_GENERATE_KEYS=true
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- Webhooks (AES-256-GCM key for endpoint signing secrets at rest) ---
# Base64 of exactly 32 raw bytes. Generate locally; never commit real keys.
# Example generator: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
WEBHOOK_SECRET_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# --- Simulation ---
PAYMENT_PROCESSOR_MODE=sandbox
