# PayFlow local environment — placeholders only.
# Copy to .env and fill in values. Never commit .env.

# --- Application ---
APP_ENV=local
APP_PORT=8080
FRONTEND_PORT=5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change_me_local_only

# JDBC URL used by Spring Boot (Compose maps container 5432 -> host 5433)
DATABASE_URL=jdbc:postgresql://localhost:5433/payflow
DATABASE_USERNAME=payflow
DATABASE_PASSWORD=change_me_local_only

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka (optional Compose profile: kafka; host listener on 9094) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
PAYFLOW_KAFKA_ENABLED=false

# --- Spring ---
SPRING_PROFILES_ACTIVE=local

# --- Security (generate local values; never use these in production) ---
JWT_SECRET=replace_with_long_random_local_secret
API_KEY_HASH_PEPPER=replace_with_local_pepper

# --- Webhooks (signing) ---
WEBHOOK_SIGNING_SECRET=replace_with_local_webhook_secret

# --- Simulation ---
PAYMENT_PROCESSOR_MODE=sandbox
