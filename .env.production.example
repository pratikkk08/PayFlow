# PayFlow production environment — PLACEHOLDERS ONLY.
# Copy to a private secret store / deployment env. Never commit real values.
# Simulation sandbox only — no live card processing.

SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080

# --- PostgreSQL (required) ---
DATABASE_URL=jdbc:postgresql://REPLACE_DB_HOST:5432/payflow
DATABASE_USERNAME=REPLACE_DB_USER
DATABASE_PASSWORD=REPLACE_STRONG_DB_PASSWORD

# --- Redis (required host) ---
REDIS_HOST=REPLACE_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT RSA PEMs (mounted files; auto-generate forbidden in prod) ---
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_AUTO_GENERATE_KEYS=false
JWT_ISSUER=payflow
JWT_AUDIENCE=payflow-api
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- API key HMAC pepper (min 32 chars; not a local placeholder) ---
API_KEY_HASH_PEPPER=REPLACE_WITH_LONG_RANDOM_PEPPER

# --- Webhook AES-256-GCM key: Base64 of exactly 32 raw bytes ---
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Browser CORS (comma-separated absolute https origins; no localhost) ---
PAYFLOW_CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Explicit opt-in workers (default off) ---
PAYFLOW_KAFKA_ENABLED=false
PAYFLOW_KAFKA_CONSUMER_ENABLED=false
PAYFLOW_OUTBOX_PUBLISHER_ENABLED=false
PAYFLOW_WEBHOOK_DELIVERY_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=REPLACE_IF_KAFKA_ENABLED

# --- Frontend Nginx upstream (Compose service names) ---
PAYFLOW_BACKEND_HOST=backend
PAYFLOW_BACKEND_PORT=8080

# --- Deploy Compose (infra/docker-compose.deploy.yml) ---
# Only frontend publishes a host port. Postgres/Redis/backend stay internal.
PAYFLOW_DEPLOY_HTTP_PORT=18080
POSTGRES_DB=payflow
POSTGRES_USER=REPLACE_DB_USER
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
# Host paths to PEM files mounted read-only at /run/secrets/*.pem
PAYFLOW_JWT_PRIVATE_KEY_FILE=/absolute/path/to/jwt-private.pem
PAYFLOW_JWT_PUBLIC_KEY_FILE=/absolute/path/to/jwt-public.pem

# For local deploy smoke only (gitignored): .\scripts\prepare-deploy-smoke-secrets.ps1
# then: docker compose -f infra/docker-compose.deploy.yml --env-file secrets/deploy-smoke/.env up -d --build

# TLS is terminated at the reverse proxy / load balancer — do not commit certificates.
