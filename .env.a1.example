# PayFlow Oracle Always Free A1 — PLACEHOLDERS ONLY (Task 9.4).
# Copy to a private env file outside Git (e.g. secrets/a1/.env). Never commit real values.
# Budget: ₹0/month. Do not enable paid OCI shapes or services.
# Simulation sandbox only — no live card processing.

SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL (Compose internal DNS; do not publish host ports) ---
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
DATABASE_URL=jdbc:postgresql://postgres:5432/payflow
DATABASE_USERNAME=payflow
DATABASE_PASSWORD=REPLACE_STRONG_DB_PASSWORD

# --- Redis (internal) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT PEMs (host paths mounted read-only) ---
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_AUTO_GENERATE_KEYS=false
PAYFLOW_JWT_PRIVATE_KEY_FILE=/absolute/path/to/jwt-private.pem
PAYFLOW_JWT_PUBLIC_KEY_FILE=/absolute/path/to/jwt-public.pem

# --- Secrets ---
API_KEY_HASH_PEPPER=REPLACE_WITH_LONG_RANDOM_PEPPER
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Browser CORS: exact https origin (prod rejects localhost) ---
# Examples after free DNS: https://YOUR_IP.sslip.io or https://YOUR_NAME.duckdns.org
PAYFLOW_CORS_ALLOWED_ORIGINS=https://REPLACE_FREE_HOSTNAME

# --- Free-tier workers: keep OFF on A1 ---
PAYFLOW_KAFKA_ENABLED=false
PAYFLOW_KAFKA_CONSUMER_ENABLED=false
PAYFLOW_OUTBOX_PUBLISHER_ENABLED=false
PAYFLOW_WEBHOOK_DELIVERY_ENABLED=false

# --- Publish web only (local smoke stays loopback; on A1 set 0.0.0.0 after TLS is ready) ---
PAYFLOW_DEPLOY_BIND=127.0.0.1
PAYFLOW_DEPLOY_HTTP_PORT=18080

# Optional JVM override for 6–12 GB VMs (Compose arm64 override has a safe default)
# BACKEND_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -XX:InitialRAMPercentage=20.0 -XX:+UseContainerSupport -Djava.security.egd=file:/dev/./urandom
